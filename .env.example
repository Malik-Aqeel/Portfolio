# ==============================================================================
# Google Ads Strategy Call Booking System - Environment Configuration
# ==============================================================================

# Server Port & Allowed Client URL
PORT=5000
CLIENT_URL=http://localhost:3000

# Owner Notification Email (Receives all booking alerts)
OWNER_EMAIL=shehzadsadiq172@gmail.com

# Dedicated Google Meet or Zoom URL (Instant 1-step setup):
# Create a meeting at https://meet.google.com (click "New meeting" > "Create a meeting for later")
# and paste your link below. This provides an immediate, 100% working meeting room!
GOOGLE_MEET_URL=https://meet.google.com/your-meeting-code

# ------------------------------------------------------------------------------
# 1. GOOGLE CALENDAR API (OAuth2 - For Automatic Unique Room Generation)
# ------------------------------------------------------------------------------
# Google Cloud Console: Enable "Google Calendar API", create an OAuth 2.0 Client ID.
# Run `npm run oauth:init` to authorize and generate your GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here
GOOGLE_CALENDAR_ID=primary

# ------------------------------------------------------------------------------
# 2. RESEND TRANSACTIONAL EMAIL SERVICE
# ------------------------------------------------------------------------------
# Sign up at https://resend.com (free tier provides 3,000 emails/month).
# Generate an API key with sending permissions.
# In development without a custom verified domain, Resend uses "onboarding@resend.dev".
# Once your custom domain is verified in Resend, you can set SENDER_EMAIL="Shehzad Sadiq <strategy@yourdomain.com>".
RESEND_API_KEY=your_resend_api_key_here
SENDER_EMAIL=onboarding@resend.dev
